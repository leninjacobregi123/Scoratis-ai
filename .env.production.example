# Scoratis - Production environment for docker-compose.prod.yml
#
# Copy this to `.env.production` on the VM and fill in real values.
# NEVER commit the real .env.production - it holds live secrets.

# ----- Deployment -----
# Refuses to boot if SCORATIS_ENCRYPTION_KEY/JWT_SECRET_KEY are still the
# insecure defaults below - see backend/main.py's
# _guard_against_insecure_production_secrets().
ENVIRONMENT=production

# The public hostname Caddy requests a Let's Encrypt cert for - use the free
# DNS label Azure assigns the VM's public IP, e.g.:
DOMAIN=scoratis.eastus.cloudapp.azure.com

# ----- Database (the `postgres` service in docker-compose.prod.yml) -----
POSTGRES_PASSWORD=change-me-generate-a-strong-password
DATABASE_URL=postgresql://scoratis:change-me-generate-a-strong-password@postgres:5432/scoratis
DATABASE_URL_ASYNC=postgresql+asyncpg://scoratis:change-me-generate-a-strong-password@postgres:5432/scoratis

# ----- Redis (the `redis` service) -----
REDIS_URL=redis://redis:6379/0

# ----- Embeddings -----
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ----- RAG Settings -----
RAG_SIMILARITY_THRESHOLD=0.5
RAG_MAX_JOURNAL_RESULTS=3
RAG_MAX_CONVERSATION_RESULTS=5

# ----- Web Search -----
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3
# Required for web search to actually work - free tier at tavily.com
TAVILY_API_KEY=your_tavily_api_key

# ----- Memory -----
SHORT_TERM_MEMORY_LIMIT=20

# ----- LLM Provider -----
# Local/Ollama providers were removed entirely - cloud only. Every account
# must configure its own provider/API key in Settings; there is no
# deployment-wide default any account silently inherits. DEFAULT_LLM_MODEL/
# PROVIDER below are just the pydantic Settings default and a few
# system-level fallbacks (e.g. the legacy non-streaming /chat endpoint) -
# not a live per-user fallback.
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ----- Other API Keys -----
GEMINI_API_KEY=your_gemini_api_key
YOUTUBE_API_KEY=your_youtube_api_key

# ----- Encryption - REQUIRED, generate real random values -----
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SCORATIS_ENCRYPTION_KEY=
SCORATIS_ENCRYPTION_SALT=

# ----- Auth (JWT) - REQUIRED, generate a real random value -----
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ----- Google Sign-In - optional, leave both blank to disable the button -----
# Create a Web application OAuth Client ID at
# https://console.cloud.google.com/apis/credentials with this deploy's
# HTTPS origin (e.g. https://scoratis.eastus.cloudapp.azure.com) added under
# "Authorized JavaScript origins". No client secret is used - this app only
# verifies the ID token Google's SDK returns, it never exchanges a code.
# Both values must be the SAME Client ID (one is read by the backend at
# request time, the other is baked into the frontend bundle at build time -
# see docker-compose.prod.yml's frontend build args).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ----- CORS - the real public HTTPS origin, no trailing slash -----
ALLOWED_ORIGINS=https://scoratis.eastus.cloudapp.azure.com
