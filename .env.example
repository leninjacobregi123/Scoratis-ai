# Scoratis Environment Configuration

# Deployment - set to "production" on a real deploy. When production, the app
# refuses to start if SCORATIS_ENCRYPTION_KEY/JWT_SECRET_KEY are still default.
ENVIRONMENT=development

# Database (PostgreSQL - adjust the port if 5433/5434 are already in use on your machine)
DATABASE_URL=postgresql://scoratis:scoratis_password@localhost:5434/scoratis
DATABASE_URL_ASYNC=postgresql+asyncpg://scoratis:scoratis_password@localhost:5434/scoratis

# Legacy SQLite (for rollback)
USE_LEGACY_DB=false
SQLITE_PATH=../scoratis.db

# Redis (adjust the port if 6379 is already in use on your machine)
REDIS_URL=redis://localhost:6381/0

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# RAG Settings
RAG_SIMILARITY_THRESHOLD=0.5
RAG_MAX_JOURNAL_RESULTS=3
RAG_MAX_CONVERSATION_RESULTS=5

# Web Search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3

# Memory
SHORT_TERM_MEMORY_LIMIT=20

# LLM Provider
# Ollama only works when it's reachable from where the app runs - fine for
# local dev, not for a PaaS deploy with no GPU box behind it. In production,
# point DEFAULT_LLM_PROVIDER/DEFAULT_LLM_MODEL at a cloud provider instead
# (e.g. "groq" + "llama-3.3-70b-versatile", or "openai" + "gpt-4o-mini") and
# set the matching *_API_KEY below. Leave OLLAMA_BASE_URL set only for local dev.
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=your_groq_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# API Keys (existing)
GEMINI_API_KEY=your_gemini_api_key
YOUTUBE_API_KEY=your_youtube_api_key

# Encryption - REQUIRED for production, generate real random values before deploying.
# e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
SCORATIS_ENCRYPTION_KEY=scoratis-default-dev-key-change-in-production-32chars
SCORATIS_ENCRYPTION_SALT=scoratis-salt-value

# Auth (JWT) - REQUIRED for production, generate a real random value before deploying.
JWT_SECRET_KEY=scoratis-default-dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
