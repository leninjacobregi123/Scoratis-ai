# Scoratis Environment Configuration

# Database (PostgreSQL - port 5433 to avoid conflict with local PostgreSQL)
DATABASE_URL=postgresql://scoratis:scoratis_password@localhost:5433/scoratis
DATABASE_URL_ASYNC=postgresql+asyncpg://scoratis:scoratis_password@localhost:5433/scoratis

# Legacy SQLite (for rollback)
USE_LEGACY_DB=false
SQLITE_PATH=../scoratis.db

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# RAG Settings
RAG_SIMILARITY_THRESHOLD=0.5
RAG_MAX_JOURNAL_RESULTS=3
RAG_MAX_CONVERSATION_RESULTS=5

# Web Search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3

# Memory
SHORT_TERM_MEMORY_LIMIT=20

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434

# API Keys (existing)
GEMINI_API_KEY=your_gemini_api_key
YOUTUBE_API_KEY=your_youtube_api_key
